<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f2f2f2;
        color: #333;
        padding: 40px;
    }

    h1 {
        font-size: 28px;
        margin-bottom: 20px;
        color: #222;
    }

    form {
        background-color: #fff;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        max-width: 400px;
    }

    label {
        display: block;
        margin-top: 15px;
        font-weight: bold;
    }

    input[type="text"],
    input[type="password"] {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        border: 1px solid #ccc;
        border-radius: 5px;
        box-sizing: border-box;
    }

    button {
        margin-top: 20px;
        padding: 10px 20px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        button:hover {
            background-color: #0056b3;
        }

    p {
        margin-top: 15px;
        color: red;
    }
</style>

<h1>Login</h1>
<form method="post">
	<label>Ingrese email</label>
	<input type="text" name="email"  />
	<label>Ingrese contrasenia</label>
	<input type="password" name="contrasenia"  />
	<button type="submit">Ingresar</button>
</form>

<p>@ViewBag.Mensaje</p>
