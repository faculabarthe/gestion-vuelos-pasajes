@using Dominio;
@model Cliente

<style>
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 14px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        overflow: hidden;
    }

    thead {
        background-color: #2c3e50;
        color: #ecf0f1;
    }

    th, td {
        padding: 14px 18px;
        text-align: left;
    }

    th {
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: 0.05em;
    }

    tbody tr:nth-child(even) {
        background-color: #f2f6fa;
    }

    tbody tr:nth-child(odd) {
        background-color: #ffffff;
    }

    tbody tr:hover {
        background-color: #d0e6f7;
        cursor: pointer;
    }

    td {
        color: #2c3e50;
    }
</style>



@if (Model is Premium p) 
{
    <table>
        <thead>
            <tr>
                <th>DOCUMENTO</th>
                <th>NOMBRE</th>
                <th>Nacionalidad</th>
                <th>EMAIL</th>
                <th>PUNTOS</th>

            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@p.Documento</td>
                <td>@p.Nombre</td>
                <td>@p.Nacionalidad</td>
                <td>@p.Email</td>
                <td>@p.Puntos</td>

            </tr>
        </tbody>
    </table>

}else{
<table>
    <thead>
        <tr>
            <th>DOCUMENTO</th>
            <th>NOMBRE</th>
            <th>Nacionalidad</th>
            <th>EMAIL</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Documento</td>
            <td>@Model.Nombre</td>
            <td>@Model.Nacionalidad</td>
            <td>@Model.Email</td>
        </tr>
    </tbody>
</table>

}